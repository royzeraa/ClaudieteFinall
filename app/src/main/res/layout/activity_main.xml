<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Título -->
        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/titulo_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Imagen -->
        <ImageView
            android:id="@+id/imgFoto"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/titulo_principal"
            android:scaleType="centerCrop"
            android:src="@drawable/mi_imagen" />

        <!-- Botón Audio -->
        <Button
            android:id="@+id/btnAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_audio_play" />

        <!-- Botón Animar -->
        <Button
            android:id="@+id/btnAnimar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_animar" />

        <!-- Botón Video -->
        <Button
            android:id="@+id/btnVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_video" />

        <!-- Reproductor de video -->
        <VideoView
            android:id="@+id/vistaVideo"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
